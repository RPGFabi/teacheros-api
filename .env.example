APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teacheros
DB_USERNAME=teacheros
DB_PASSWORD=teacheros

# Auth-Instanz der Schule (ADR 0002 "Grundsatz"); schreibt scripts/auth-instance.sh setup automatisch.
# Pfad zur Datei mit dem oeffentlichen RS256-Schluessel der Schul-Auth-Instanz (kein Secret).
AUTH_PUBLIC_KEY_PATH=
# Erwartete JWT-Claims: muessen exakt TOKEN_ISSUER/TOKEN_AUDIENCE der Auth-Instanz entsprechen.
AUTH_TOKEN_ISSUER=https://auth.dev-schule.teacheros.test
AUTH_TOKEN_AUDIENCE=teacheros:dev-schule
# Basis-URL der Auth-Instanz (lokal: Port 8100).
AUTH_BASE_URL=http://127.0.0.1:8100
