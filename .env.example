APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=teacheros
DB_USER=teacheros
DB_PASSWORD=teacheros

# Tests: Testdatenbank teacheros_test_<zufall> wird automatisch angelegt
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=3306
# TEST_DB_USER=teacheros
# TEST_DB_PASSWORD=teacheros
# Auth-Instanz der Schule (ADR 0002 "Grundsatz"); schreibt scripts/auth-instance.sh setup automatisch.
# Pfad zur Datei mit dem oeffentlichen RS256-Schluessel der Schul-Auth-Instanz (kein Secret).
AUTH_PUBLIC_KEY_PATH=
# Erwartete JWT-Claims: muessen exakt TOKEN_ISSUER/TOKEN_AUDIENCE der Auth-Instanz entsprechen.
AUTH_TOKEN_ISSUER=https://auth.dev-schule.teacheros.test
AUTH_TOKEN_AUDIENCE=teacheros:dev-schule
# Basis-URL der Auth-Instanz (lokal: Port 8100) fuer die internen, signierten Aufrufe (Einladung).
AUTH_SERVICE_URL=http://127.0.0.1:8100
# Gemeinsames Secret der internen Aufrufe (= AUTH_SERVER_WEBHOOK_SECRET der Auth-Instanz). Echtes Secret, nie einchecken.
AUTH_SERVICE_WEBHOOK_SECRET=
# Timeout der internen Aufrufe in Sekunden (Standard 5) und Name des Signatur-Headers (Standard X-Webhook-Signature).
# AUTH_SERVICE_TIMEOUT_SECONDS=5
# AUTH_SERVICE_SIGNATURE_HEADER=X-Webhook-Signature

# CORS fuer das Web-Frontend (Vite-Dev-Server)
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_HEADERS=Authorization,Content-Type
